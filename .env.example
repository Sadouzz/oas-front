# OAS FRONTEND — copier ce fichier vers .env à la racine de oas-front.
# npm start et npm run build chargent .env et génèrent src/environments/*.ts.

# URL de l'API utilisée par ng serve / le build de développement.
API_URL=http://localhost:9090

# URL de l'API intégrée au build de production.
# Remplacer si l'API de production utilise une autre adresse.
API_URL_PROD=https://api.oas-senegal.com

# Garder development en local. Dans le pipeline de release, définir NODE_ENV=production
# avant le build afin d'appliquer la configuration CSP de production.
NODE_ENV=development

# Alias historiques reconnus par set-env.js si les variables API_URL ci-dessus sont absentes :
# OAS_API_URL=http://localhost:9090
# OAS_API_URL_PROD=https://api.oas-senegal.com
